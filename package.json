{
  "name": "genspark-shell",
  "version": "1.0.0",
  "description": "A macOS desktop shell for genspark.ai with user script injection",
  "main": "src/main.js",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "restart": "bash restart.sh",
    "test": "node --test 'test/*.test.js'",
    "dist": "electron-builder --mac",
    "test:rename": "electron test/integration/rename.js",
    "test:early": "electron test/integration/early-inject.js",
    "test:popup": "electron test/integration/popup.js",
    "test:flicker": "electron test/integration/flicker.js"
  },
  "devDependencies": {
    "electron": "43.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ezreal.genspark-shell",
    "productName": "老猫",
    "executableName": "laomao",
    "files": [
      "src/**",
      "seed/**",
      "client-config.json",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "laomao-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "laomao-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "afterPack": "scripts/afterPack.js"
  }
}
